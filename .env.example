# Copy this file to .env and fill in your values:
#   cp .env.example .env
# .env is gitignored — never commit real keys.

# ── API key (required) ─────────────────────────────────────────────────
# OpenRouter is the only provider: chat, analysis, and embeddings all go
# through it. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── ChromaDB storage path (required) ───────────────────────────────────
# Absolute path where ChromaDB persists the vector database. Keep it OUTSIDE
# the repo so rebuilds and git operations never collide.
CHROMA_DB_PATH=/home/you/site_chatbot_db

# ── Server (optional) ──────────────────────────────────────────────────
# PORT=5000
# Comma-separated list of allowed CORS origins; * (default) allows all.
# CORS_ORIGINS=https://www.your-site.org,https://dashboard.your-site.org

# ── Email delivery (optional) ──────────────────────────────────────────
# Used by the automated weekly analysis emails, and by the "Email it" button
# on a completed guided-workflow response.
# RECIPIENT_EMAIL accepts a comma-separated list.
SENDER_EMAIL=your_sender_email@gmail.com
SENDER_PASSWORD=your_gmail_app_password
RECIPIENT_EMAIL=your_recipient_email@gmail.com
# SMTP defaults work for Gmail; override only for another provider.
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587

# ── Guided workflows (optional) ────────────────────────────────────────
# Where completed questionnaire responses are written. Relative paths resolve
# against the repo root. These can contain personal details and no HTTP route
# serves them back, so point this somewhere you control.
# WORKFLOW_RESPONSES_DIR=workflow_responses
# Where workflow spec files are read from (see workflows/README.md).
# WORKFLOWS_DIR=workflows

# ── Model overrides (optional) ─────────────────────────────────────────
# Every LLM call goes through llm_client.py; override per-role models here.
# CHAT_MODEL=qwen/qwen3.5-397b-a17b
# ANALYSIS_MODEL=deepseek/deepseek-v4-flash
# JUDGE_MODEL=deepseek/deepseek-v4-flash
# EMBED_MODEL=google/gemini-embedding-001
